# Copy this file to .env and fill in your own values.
# NEVER commit .env - it is excluded in .gitignore.

# Google Gemini API (free tier)
# Get a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hashnode personal access token
# Get one from: https://hashnode.com/settings/developer
# NOTE: as of 2026-05-13 Hashnode requires a Pro plan for GraphQL API access.
#       Without it, the publishing stage will fail. Set PUBLISH_TO_HASHNODE = False
#       in src/config.py to run stages 1-3 only.
HASHNODE_ACCESS_TOKEN=

# Hashnode publication ID (looks like a UUID)
# Find it in your blog dashboard URL or publication settings.
HASHNODE_PUBLICATION_ID=
